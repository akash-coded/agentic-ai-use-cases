# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit your real IDs.

AWS_REGION=us-east-1

# Knowledge Base — get this from the Bedrock console after sync completes
KB_ID=YOUR_KB_ID_HERE

# Guardrail — get this from the Bedrock console after creating a version
GUARDRAIL_ID=YOUR_GUARDRAIL_ID_HERE
GUARDRAIL_VERSION=1
