# AWS credential variables are optional when using an AWS profile, IAM role, or SSO session.
AWS_REGION=us-east-1
AWS_PROFILE=

# Prior-course default. Override with another Bedrock tool-capable model if available.
STRANDS_MODEL_ID=us.amazon.nova-lite-v1:0

# Keep false until credentials and model access are configured.
RUN_LIVE=false
ENABLE_CONSOLE_OTEL=false
LOG_LEVEL=INFO
ENVIRONMENT=lab

STRANDS_SESSION_ID=travelmind-graph-swarm-lab
AUDIT_PATH=./artifacts/travelmind_audit.jsonl
GRAPH_TIMEOUT_SECONDS=180
NODE_TIMEOUT_SECONDS=60
SWARM_TIMEOUT_SECONDS=90
MAX_SWARM_HANDOFFS=6
MAX_SWARM_ITERATIONS=8
